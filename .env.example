DATABASE_URL="postgresql://USER@localhost:5432/uriel"
AUTH_SECRET="replace-with-a-long-random-string"
URIEL_OPERATOR_EMAIL="operator@uriel.local"
URIEL_OPERATOR_PASSWORD="choose-a-password"

# Optional. The order path does not call the model.
XAI_API_KEY=""

# Robinhood agent account. Leave blank to stay on the paper ledger.
# Live orders also require LIVE_TRADING=true and ROBINHOOD_ORDER_CONFIRMED=true.
ROBINHOOD_MCP_URL="https://agent.robinhood.com/mcp/trading"
ROBINHOOD_MCP_TOKEN=""
LIVE_TRADING="false"
ROBINHOOD_ORDER_CONFIRMED="false"
